#!/bin/sh
# commit-msg 钩子（DeepSeek 评审 #9 采纳）：校验 commit message 含合法 ID 引用。
# 安装：git config core.hooksPath .githooks（或复制到 .git/hooks/commit-msg）
# 失败即拒绝提交：message 必须含 GATE-* / RV-* / DEC-* / ISS-* 之一。

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# 合并后续行（subject 用整段判断，避免 body 遗漏）
if ! printf '%s' "$MSG" | grep -Eq '\b(GATE|RV|DEC|ISS)[-:][0-9]{6,8}(-[0-9]+)?\b|\bISS-[0-9]+\b'; then
    echo "✗ commit-msg 钩子拒绝：message 必须含 ID 引用（GATE-* / RV-* / DEC-* / ISS-*）" >&2
    echo "  示例：feat(scope): 描述 (RV-20260923-05, GATE-20260923-01)" >&2
    echo "  或引用开放问题：fix: ... (ISS-53)" >&2
    exit 1
fi

# 若存在 trace_gate.py，再做存在性提示（不阻塞：钩子最小化，不依赖 PYTHONPATH）
exit 0
